{
  "name": "todo-list",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "todo-api"
  ],
  "scripts": {
    "dev": "docker compose up -d --wait db && concurrently -k -n api,web -c blue,green \"npm run start:dev --workspace todo-api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace todo-api",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "npm run start:prod --workspace todo-api"
  },
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
